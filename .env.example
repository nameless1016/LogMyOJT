# ==============================================================================
# LogMyOJT Environment Configuration Template
# Copy this file to .env and customize the values for your environment.
# Never commit your real .env file or production secrets to source control.
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration
# Supabase PostgreSQL Session Pooler connection string:
# DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Leave unset or empty to automatically fall back to local SQLite (db.sqlite3)
DATABASE_URL=

# Email Settings (Console backend in dev, SMTP in production)
# Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=LogMyOJT <noreply@logmyojt.local>

# Production Security Toggles (applicable when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
